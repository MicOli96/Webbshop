generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  imageUrl    String
  imageCredit String?
  stock       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  idempotencyKey String      @unique
  customerName   String
  email          String
  phone          String
  address        String
  total          Float
  items          OrderItem[]
  createdAt      DateTime    @default(now())
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id])
  productId String
  title     String
  price     Float
  quantity  Int
}
